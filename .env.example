OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Persistent ceiling; includes failed attempts. Increase deliberately for the full dataset.
OPENAI_MAX_CALLS=3
OPENAI_MAX_OUTPUT_TOKENS=2600
DATASET_FILE=data/dev_dataset.json
# Optional signed organizer URL. Never commit the real URL/signature.
DATASET_URL=
DATA_STORE_PATH=data/data_store.json
# Empty = local demo role switch. Set a token to protect supervisor writes.
QA_SUPERVISOR_TOKEN=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
